# Copy to .env (or set in your host's dashboard). Never commit real keys.

# Shared review database. Set in production (Render/Supabase/Neon give you this
# string). If UNSET, the app stores shared content in a local file (data/community.json)
# — perfect for running on your own computer; not for production.
DATABASE_URL=

# Optional: outside-review API keys. Leave blank to launch without them.
GOOGLE_PLACES_KEY=your_google_places_api_key
YELP_API_KEY=your_yelp_fusion_api_key

# Reddit (official API — free). Create an app at https://www.reddit.com/prefs/apps
# (type: "script" or "web app"). You need the client id + secret.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=web:radiator:v1.0 (by u/yourusername)
REDDIT_SUBS=chicago+chicagoapartments+LoganSquare+uptown+rogerspark

PORT=8787
CACHE_HOURS=12

# CORS. The app is same-origin, so leave this UNSET for normal operation —
# same-origin requests work with no CORS header. To allow specific cross-origin
# callers, set an EXACT comma-separated origin allowlist, e.g.
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
# A literal "*" is treated as INVALID/disabled: the server will NEVER emit
# `Access-Control-Allow-Origin: *`, and an unlisted origin gets no CORS header.
CORS_ORIGIN=

# ---- Intentionally-OFF production features (default disabled) ----
# Each requires BOTH its flag AND its secret; the secret alone does nothing, so
# secrets can stay stored in production while the feature stays off. Do NOT set
# these flags on production or preview unless you are deliberately launching the
# feature.

# Payments (Stripe Checkout). OFF unless BOTH are set:
#   PAYMENTS_ENABLED=1  and  STRIPE_SECRET_KEY=sk_live_...
# With payments off, Stripe is never initialized (no network call) and
# POST /api/checkout returns 503 / /api/payments/status reports disabled.
PAYMENTS_ENABLED=
STRIPE_SECRET_KEY=

# Moderation (verified-tenant queue/approve/reject). OFF unless BOTH are set:
#   MODERATION_ENABLED=1  and  ADMIN_KEY=<long-random-secret>
# The moderator key is accepted ONLY via the `X-Admin-Key` request header
# (never query string, request body, or browser storage). With moderation off,
# the moderation endpoints return 503.
MODERATION_ENABLED=
ADMIN_KEY=

# Lease/tenancy-proof verification. OFF unless LEASE_VERIFY=1 (default disabled;
# POST /api/verify returns 503). Collects a sensitive document, so it is gated
# SERVER-SIDE — a client cannot enable it.
LEASE_VERIFY=

# Preview/staging only. Set PREVIEW_MODE=1 on a NON-production preview deploy
# (e.g. radiator-preview.onrender.com) so every response sends
# `X-Robots-Tag: noindex, nofollow, noarchive`, server-rendered entity pages add
# a matching robots meta tag, and robots.txt stops advertising the sitemap — the
# preview stays crawlable for QA but is not indexed as duplicate content.
# Leave UNSET in production: getradiator.com must remain indexable. As a
# safeguard the noindex behavior also refuses to activate on getradiator.com,
# www.getradiator.com, and radiator-pkt6.onrender.com even if this is mis-set.
PREVIEW_MODE=
